# ---------------------------------------------------------------------------
# trade-mcp configuration
# Copy to .env  (or export these variables / put them in opencode.json)
# ---------------------------------------------------------------------------

# Backend: "bridge" = talk to the MQL5 EA inside MetaTrader 5, "mock" = fake data
TRADE_MCP_BACKEND=bridge

# Where the Python side listens. The EA inside MT5 connects to this address.
TRADE_MCP_HOST=127.0.0.1
TRADE_MCP_PORT=8787

# Default instrument + timeframes used when a tool call omits them
TRADE_MCP_SYMBOL=XAUUSD
TRADE_MCP_TIMEFRAMES=M15,H1,H4

# --- Trading guard rails ---------------------------------------------------
# Master switch. false => confirm_order never sends anything to the broker.
TRADE_MCP_ALLOW_TRADING=false

# Hard limits enforced before any order reaches MT5
TRADE_MCP_MAX_LOT=0.10
TRADE_MCP_MAX_RISK_PERCENT=1.0
TRADE_MCP_MAX_OPEN_POSITIONS=3
TRADE_MCP_MAX_SPREAD_POINTS=60
# Comma separated. A symbol matches if it equals an entry or starts with it
# (so XAUUSD.a / XAUUSDm also match XAUUSD).
TRADE_MCP_ALLOWED_SYMBOLS=XAUUSD,GOLD,XAU

# A proposal must be confirmed within this many seconds
TRADE_MCP_PROPOSAL_TTL=180

# Journal / proposal database
TRADE_MCP_JOURNAL=~/.local/share/trade-mcp/journal.sqlite3

# Seconds to wait for the EA to answer a command
TRADE_MCP_TIMEOUT=20
